{
  "name": "nutryx-proxy",
  "version": "0.1.0",
  "description": "Minimal local proxy for NUTRYX to keep API keys server-side",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "dev:all": "node scripts/dev-all.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.35.0",
    "dexie": "^3.2.4",
    "googleapis": "^121.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "vite": "^5.1.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
